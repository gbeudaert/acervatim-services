# ---------------------------------------------------------------------------
# acervatim-backend-lego - variables d'environnement
# Copier en `.env` puis remplir. Les valeurs sensibles ne sont jamais versionnees.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3010

# Base : schema logique dedie au service. En dev via docker compose, l'hote est `db`.
DATABASE_URL="mysql://acervatim:changeme@localhost:3307/acv_cat_lego"
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=acv_cat_lego
MARIADB_USER=acervatim
MARIADB_PASSWORD=changeme

# Redis : backing store des files BullMQ (debit sortant + single-flight).
REDIS_HOST=localhost
REDIS_PORT=6380

# Cle PUBLIQUE de verification des JWT emis par `identity` (aujourd'hui le monolithe).
# Ce service ne signe rien : pas de cle privee ici, c'est volontaire.
# Recopier la valeur de JWT_PUBLIC_KEY du backend, newlines echappees en \n.
JWT_PUBLIC_KEY=""

# Secret HMAC du principal signe pose par le gateway (X-Acervatim-Principal).
# Laisser vide tant qu'il n'y a pas de gateway : le service accepte alors le JWT seul.
# INTERNAL_PRINCIPAL_SECRET=

# Chiffrement AES-256-GCM des cles API personnelles. base64 de 32 octets :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Jeton des routes /admin/* et /internal/*. Dans la cible, /internal/* passe au secret
# de service a service ; en attendant, un seul jeton couvre les deux.
ADMIN_API_TOKEN=""

# --- Rebrickable : source nominale du catalogue -----------------------------
# Cle gratuite en libre-service : compte Rebrickable > Settings > API.
# Sert de repli premium ; chaque utilisateur peut fournir la sienne
# (PUT /v1/sources/rebrickable/token).
REBRICKABLE_API_KEY=
REBRICKABLE_BASE_URL=https://rebrickable.com/api/v3

# --- Brickset : codes-barres, moissonnage hors ligne uniquement -------------
# Cle sur demande : brickset.com/tools/webservices/requestkey
# Une cle libre plafonne a 100 appels getSets/jour. Le budget ci-dessous garde une
# marge sous ce plafond ; le moissonneur s'arrete de lui-meme quand il est atteint.
BRICKSET_API_KEY=
BRICKSET_BASE_URL=https://brickset.com/api/v3.asmx
BRICKSET_DAILY_CALL_BUDGET=90
BRICKSET_PAGE_SIZE=500

# Identite HTTP sortante. Les deux sources tracent l'User-Agent ; en mettre un
# identifiable evite d'etre confondu avec un scraper anonyme.
HTTP_USER_AGENT="Acervatim-Lego/0.1 (+contact@acervatim.local)"

# Origines CORS autorisees (vide = aucune : l'app Android n'en a pas besoin).
CORS_ORIGINS=

# Quadlet Podman de la constellation micro-services Acervatim.
#
# Les onze services applicatifs tournent dans **un seul pod**, decrit par `acervatim.yaml`.
# Redis est a cote, en unite `.container` distincte : il a un cycle de vie propre et ne doit
# pas redemarrer a chaque livraison de code. La base est celle du monolithe : onze schemas
# `acv_*` sur son instance MariaDB, hors de l'hote (decision D1 du 2026-11-21).
#
# ### Pourquoi un pod unique plutot que onze
#
# Les onze conteneurs partagent alors une pile reseau : ils se joignent en `localhost:31xx`,
# sans DNS ni resolution de nom entre eux. Trois consequences, toutes voulues :
#
#   - **un seul port publie sur l'hote** (3100, le gateway). Les dix autres services ne sont
#     joignables que depuis l'interieur du pod, ce qui applique par construction l'invariant du
#     6 : « aucune route /internal/* n'est exposee vers l'exterieur » ;
#   - **pas de DNS a faire fonctionner** entre onze conteneurs pour un deploiement mono-hote ;
#   - **une seule unite a redemarrer**, donc pas d'etat intermediaire ou la moitie de la
#     constellation tourne dans une version et l'autre moitie dans la precedente.
#
# Le prix : les onze services redemarrent ensemble. C'est acceptable ici parce qu'ils sont
# livres ensemble ; ce ne le serait plus le jour ou l'un d'eux se deploie a son propre rythme -
# il sortirait alors dans son propre pod, avec le reseau `acervatim-services` pour le joindre.
#
# ### Installation (rootless)
#
# Par l'archive de deploiement : `deploy/build-archive.ps1` la construit, `deploiement.sh` la
# deroule sur l'hote (deploy/README.md, 3). Le script compose le manifeste joue dans
# `~/acervatim-services/config/acervatim.yaml` (secrets + ConfigMap + Pod, en 600) : il porte
# les secrets et ne vit jamais dans le depot. Il installe `acervatim-services.network`,
# `acervatim-services-redis.container` et cette unite dans `~/.config/containers/systemd/`.
#
# Variante base locale (developpement, repetition) : installer aussi acervatim-db.container et
# ajouter `acervatim-db.service` aux `Requires=` et `After=` ci-dessous.
#
# ### Verification
#
#   systemctl --user status acervatim
#   podman pod ps
#   curl -s -o ready.json -w '%{http_code}\n' localhost:3100/health/ready   # attendu : 200
#   jq -e '.status == "ok"' ready.json                                     # attendu : true
#
# `/health/ready` du gateway repond `503` si sa base ne repond pas, et interroge la sonde de
# disponibilite des huit services qu'il route : la constellation que l'app atteint est complete
# quand il repond `200` et `"status": "ok"` (`degraded` = un service aval pas pret ou Redis
# absent). `rebrickable-data`, que le gateway ne route pas, n'y figure pas ; il se sonde de
# l'interieur du pod (deploy/README.md, 3).

[Unit]
Description=Acervatim - constellation micro-services (pod applicatif)
# Redis doit tourner AVANT. La base, distante, n'a pas d'unite ici : les migrations, en
# initContainer, attendent qu'elle accepte les connexions (migrate.sh, DB_WAIT_SECONDS) et
# empechent le pod de demarrer si elle reste injoignable.
Requires=acervatim-services-redis.service
After=acervatim-services-redis.service
After=network-online.target
Wants=network-online.target

[Kube]
# Manifeste joue (Secret + ConfigMap + Pod), compose par deploiement.sh.
Yaml=%h/acervatim-services/config/acervatim.yaml
# Reseau partage avec Redis : c'est par lui que le pod resout `acervatim-services-redis`. Les
# onze services, eux, se parlent en `localhost`.
Network=acervatim-services.network
# `--replace` implicite au demarrage : une relivraison remplace le pod au lieu d'echouer sur
# un nom deja pris.
KubeDownForce=true
LogDriver=journald

[Service]
Restart=always
# Genereux a dessein : les migrations des onze schemas tournent en initContainer, avant que
# le moindre service ne demarre, et une premiere migration sur une base vide prend du temps.
TimeoutStartSec=300
# Laisse aux onze processus Node le temps de draîner leurs files BullMQ au SIGTERM.
TimeoutStopSec=90

[Install]
WantedBy=default.target

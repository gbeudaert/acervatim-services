# MariaDB de la constellation. **Une seule instance, un schema logique par service** - c'est
# la decision actee du 7 de architecture-microservices.md, pas une commodite : onze bases
# separees couteraient onze fois l'empreinte pour des donnees qui tiennent largement dans une.
#
# ### Pourquoi la base est ICI et non dans le pod applicatif
#
# Le pod `acervatim` se remplace a chaque deploiement (`podman kube play --replace`). Y mettre
# MariaDB ferait redemarrer la base a chaque livraison de code - un arret de service pour une
# raison qui ne la concerne pas, et une fenetre de corruption a chaque fois.
#
# Deux consequences utiles decoulent de cette separation :
#   - les migrations peuvent tourner en initContainer du pod, la base etant deja prete ;
#   - `systemctl --user restart acervatim` ne touche pas aux donnees.
#
# **Pas en production** : depuis la decision D1 du 2026-11-21, les onze schemas vivent sur
# l'instance MariaDB du monolithe, hors de l'hote, et deploiement.sh n'installe pas cette unite.
# Elle reste pour une base locale (essai isole) : l'installer, ajouter `acervatim-db.service`
# aux `Requires=` et `After=` de acervatim.kube, et pointer les `DATABASE_URL_*` sur
# `acervatim-db`.
#
# Installation (rootless) :
#   1. cp acervatim-db.container ~/.config/containers/systemd/
#   2. Deposer le mot de passe : ~/acervatim-services/db.env (chmod 600), contenant
#        MARIADB_ROOT_PASSWORD=...
#        MARIADB_PASSWORD=...
#   3. systemctl --user daemon-reload && systemctl --user start acervatim-db
#   4. loginctl enable-linger $USER   (survie hors session SSH)

[Unit]
Description=Acervatim MariaDB (constellation micro-services)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/mariadb:10.11
ContainerName=acervatim-db
Network=acervatim-services.network
# Pas de PublishPort : seul le pod applicatif, sur le meme reseau Podman, accede a la base.
# L'exposer sur l'hote n'apporterait qu'une surface d'attaque - pour un diagnostic ponctuel,
# `podman exec -it acervatim-db mariadb -u acervatim -p` suffit.
Environment=MARIADB_USER=acervatim
# Base d'amorce : les onze schemas sont crees par le script d'init au premier demarrage.
Environment=MARIADB_DATABASE=acv_gateway
EnvironmentFile=%h/acervatim-services/db.env
Volume=acervatim-db-data:/var/lib/mysql
# Le script de creation des schemas, monte en lecture seule. MariaDB ne l'execute qu'a la
# PREMIERE creation du volume - c'est aussi pourquoi il est idempotent (`IF NOT EXISTS`).
Volume=%h/acervatim-services/db-init:/docker-entrypoint-initdb.d:ro,Z
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthInterval=10s
HealthRetries=5
HealthStartPeriod=30s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target

# ---------------------------------------------------------------------------
# Constellation micro-services Acervatim - environnement de developpement local.
# Copier en `.env` a la racine de backend-services, puis remplir.
#
# Un SEUL fichier pour toute la stack : docker-compose.yml le charge dans chaque
# service (`env_file`), et surcharge par service ce qui doit differer (PORT,
# DATABASE_URL, URLs des voisins). Les secrets partages - JWT, principal signe,
# peppers - doivent avoir la MEME valeur partout, ce qu'un fichier unique garantit
# par construction : c'est la raison d'etre de ce choix.
# ---------------------------------------------------------------------------

# --- Base et cache partages -------------------------------------------------
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_USER=acervatim
MARIADB_PASSWORD=changeme

# --- Identite : JWT emis par `identity`, verifie par tous -------------------
# Paire RSA. `identity` seul detient la cle PRIVEE ; les autres ne verifient.
# Newlines echappees en \n sur une seule ligne (meme convention que le monolithe).
#   openssl genrsa -out jwt.key 2048
#   openssl rsa -in jwt.key -pubout -out jwt.pub
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Audience des id_token Google verifies par `identity` (POST /v1/auth/google).
GOOGLE_CLIENT_ID=""

# --- Principal signe X-Acervatim-Principal (3.6) ----------------------------
# Secret HMAC pose par le gateway, verifie par tous les services aval. C'est ce
# qui evite un aller-retour reseau de resolution du premium sur chaque requete.
# Secret de production au meme titre que SUB_HASH_PEPPER.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
INTERNAL_PRINCIPAL_SECRET=""

# Duree de vie du principal, en secondes. Court : il est re-emis a chaque requete.
INTERNAL_PRINCIPAL_TTL=120

# --- Appels de service a service (/internal/*) ------------------------------
# Aucune route /internal/* n'est exposee par le gateway. Ce secret les protege
# entre services ; il n'a jamais a sortir du reseau interne.
INTERNAL_SERVICE_TOKEN=""

# Jeton des routes /admin/* (exploitation). Distinct du precedent : il est manie
# par un humain, pas par un service.
ADMIN_API_TOKEN=""

# --- Peppers et chiffrement -------------------------------------------------
# Hachage du `sub` Google -> pivot d'identite. `identity` seul en a besoin.
SUB_HASH_PEPPER=""
# Codes d'invitation (admin) - `billing`.
INVITE_CODE_PEPPER=""
# Codes de partage (tout utilisateur) - `sharing`. Pepper DEDIE : surface
# d'exposition et cadence de rotation differentes d'INVITE_CODE_PEPPER.
SHARE_CODE_PEPPER=""
# AES-256-GCM des jetons externes - `connections`. base64 de 32 octets :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# --- Sources externes (service `connections` et `search`) -------------------
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
# Token personnel d'un compte Discogs Acervatim : repli premium avec images.
DISCOGS_ACERVATIM_TOKEN=
DISCOGS_CALLBACK_URL=http://localhost:3100/v1/oauth/discogs/callback

MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_CALLBACK_URL=http://localhost:3100/v1/oauth/mal/callback

TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=
BNF_SRU_BASE_URL=https://catalogue.bnf.fr/api/SRU

# --- Google Play Billing (service `billing`) --------------------------------
# Optionnels en dev : sans eux, /v1/subscriptions/verify et le webhook RTDN
# repondent 503 plutot que d'inventer un etat d'abonnement.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_SA_EMAIL=
GOOGLE_PUBSUB_AUDIENCE=

# --- Divers -----------------------------------------------------------------
# Origines CORS autorisees sur le gateway (vide = aucune : l'app Android n'en a
# pas besoin). Les services aval ne sont jamais appeles par un navigateur.
CORS_ORIGINS=
HTTP_USER_AGENT="Acervatim-Backend/1.0 (+contact@acervatim.local)"
